# Copy on the lab machine:
#   cp .env.example .env
#
# Hugging Face cache root. Weights are stored under $HF_HOME/hub
# (for example /workspace/hub/models--xinlai--LISA-13B-llama2-v1).
# Clone this repo to /workspace/LISA so the git tree is not mixed with the cache.
HF_HOME=/workspace

# Optional. Needed only for gated Hub repos (not required for
# xinlai/LISA-13B-llama2-v1 or openai/clip-vit-large-patch14).
# HF_TOKEN=

# Faster Hub downloads (requires hf_transfer in requirements.txt).
HF_HUB_ENABLE_HF_TRANSFER=1
